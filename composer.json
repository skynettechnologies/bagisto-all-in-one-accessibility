{
    "name": "skynettechnologies/bagisto-all-in-one-accessibility",
    "version": "2.0.1",
    "type": "bagisto-extension",
    "description": "Quick Web Accessibility Implementation with All In One Accessibility!",
    "keywords": [
        "bagisto",
        "framework",
        "laravel",
        "accessibility",
        "wcag",
        "ada",
        "All",
        "in",
        "One",
        "Accessibility"
    ],
    "homepage": "https://www.skynettechnologies.com/bagisto-accessibility-widget",
    "authors": [
        {
            "name": "Skynet Technologies USA LLC",
            "email": "developer3@skynettechnologies.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "SkynetTechnologies\\AllinOneAccessibility\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SkynetTechnologies\\AllinOneAccessibility\\Providers\\AllinOneAccessibilityServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT"
}
